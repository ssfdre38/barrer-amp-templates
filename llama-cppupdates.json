[
    {
        "UpdateStageName": "llama.cpp Release Download (Windows)",
        "UpdateSourcePlatform": "Windows",
        "UpdateSource": "GithubRelease",
        "UpdateSourceArgs": "ggerganov/llama.cpp",
        "UpdateSourceTarget": "{{$FullRootDir}}",
        "UnzipUpdateSource": true,
        "OverwriteExistingFiles": true,
        "DeleteAfterExtract": true,
        "SkipOnFailure": false
    },
    {
        "UpdateStageName": "llama.cpp Release Download (Linux)",
        "UpdateSourcePlatform": "Linux",
        "UpdateSource": "GithubRelease",
        "UpdateSourceArgs": "ggerganov/llama.cpp",
        "UpdateSourceTarget": "{{$FullRootDir}}",
        "UnzipUpdateSource": true,
        "OverwriteExistingFiles": true,
        "DeleteAfterExtract": true,
        "SkipOnFailure": false
    },
    {
        "UpdateStageName": "Create Models Directory",
        "UpdateSourcePlatform": "All",
        "UpdateSource": "CreateDirectory",
        "UpdateSourceArgs": "{{$FullRootDir}}models",
        "SkipOnFailure": false
    },
    {
        "UpdateStageName": "Ollama Model Pull (Windows)",
        "UpdateSourcePlatform": "Windows",
        "UpdateSource": "RunCommand",
        "UpdateSourceArgs": "pwsh.exe -ExecutionPolicy Bypass -File \"{{$FullRootDir}}pull-ollama.ps1\" -Model \"{{OllamaModel}}\" -OutputDir \"{{$FullRootDir}}models\"",
        "UpdateSourceConditionSetting": "EnableOllamaPull",
        "UpdateSourceConditionValue": "True",
        "SkipOnFailure": true
    },
    {
        "UpdateStageName": "Ollama Model Pull (Linux)",
        "UpdateSourcePlatform": "Linux",
        "UpdateSource": "RunCommand",
        "UpdateSourceArgs": "bash \"{{$FullRootDir}}pull-ollama.sh\" \"{{OllamaModel}}\" \"{{$FullRootDir}}models\"",
        "UpdateSourceConditionSetting": "EnableOllamaPull",
        "UpdateSourceConditionValue": "True",
        "SkipOnFailure": true
    }
]
