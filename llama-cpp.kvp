Meta.DisplayName=llama.cpp Inference Server
Meta.Description=High-performance local LLM inference server powered by llama.cpp with in-browser chat UI and OpenAI-compatible API
Meta.OS=Windows, Linux
Meta.AarchSupport=Supported
Meta.Arch=x86_64, aarch64
Meta.Author=Daniel Elliott (ssfdre38) & Ash (Barrer Software)
Meta.URL=https://github.com/ggerganov/llama.cpp
Meta.DisplayImageSource=url:https://raw.githubusercontent.com/ggerganov/llama.cpp/master/media/llama-logo.png
Meta.EndpointURIFormat=http://{ip}:{GenericModule.App.Ports.$AppPort}
Meta.ConfigManifest=llama-cppconfig.json
Meta.ConfigRoot=llama-cpp.kvp
Meta.MinAMPVersion=2.5.0.0
Meta.DockerRequired=False
Meta.ContainerPolicy=Supported
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=False
Meta.ConfigVersion=1
Meta.ReleaseNotes=Initial release of llama.cpp inference server template with web chat and model selection
Meta.AppConfigId=a3e817d2-7c9b-4e12-850f-21f7c3e59b6a
Meta.ImportableExtensions=[]
Meta.AppIsMultiIPAware=True
App.DisplayName=llama.cpp
App.RootDir=./llama-cpp/
App.BaseDirectory=./llama-cpp/
App.ExecutableWin=llama-server.exe
App.ExecutableLinux=./llama-server
App.WorkingDir=.
App.LinuxCommandLineArgs=
App.WindowsCommandLineArgs=
App.CommandLineArgs=--model "{{ModelFile}}" --port {{$AppPort}} --host 0.0.0.0 --ctx-size {{ContextSize}} --n-gpu-layers {{GpuLayers}} --threads {{CpuThreads}} --parallel {{ParallelSlots}} {{$FormattedArgs}} {{CustomArgs}}
App.UseLinuxIOREDIR=False
App.AppSettings={}
App.ExitMethod=OS_CLOSE
App.ExitTimeout=30
App.ExitString=stop
App.HasWriteableConsole=True
App.HasReadableConsole=True
App.UDPLogger=False
App.SupportsLiveSettingsChanges=False
App.ForceIPBinding=False
App.SupportsIPv6=True
App.ApplicationIPBinding=0.0.0.0
App.Ports=@IncludeJson[llama-cppports.json]
App.AdminPortRef=0
App.PrimaryApplicationPortRef=AppPort
App.UniversalSleepApplicationUDPPortRef=0
App.UniversalSleepSteamQueryPortRef=0
App.MaxUsers=100
App.UseRandomAdminPassword=False
App.UpdateSources=@IncludeJson[llama-cppupdates.json]
App.PreStartStages=[]
App.UserActions=[]
App.ForceUpdate=False
App.Compatibility=None
App.SupportsUniversalSleep=False
App.WakeupMode=Any
App.ApplicationReadyMode=RegexMatch
Console.AppReadyRegex=.*(HTTP server listening|main: server listening|all slots are idle).*
